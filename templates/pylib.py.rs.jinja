use pyo3::prelude::*;

mod pyrust;
mod messages;

use pyrust::*;


/// A Python module implemented in Rust.
#[pymodule]
fn {{lib_name}}(m: &Bound<'_, PyModule>) -> PyResult<()> {
    m.add("BITIS_VERSION", messages::BITIS_VERSION)?;
    m.add("BITIS_SCHEMA_HASH", messages::BITIS_SCHEMA_HASH)?;
    m.add("DecodeError", m.py().get_type::<bitis_py_errors::DecodeError>())?;
    m.add("EncodeError", m.py().get_type::<bitis_py_errors::EncodeError>())?;

{% for ce in d.enums +%}
    m.add_class::<{{ce.name}}>()?;
{%- endfor +%}
{% for cm in d.msgs +%}
    m.add_class::<{{cm.name}}>()?;
{%- endfor +%}
{%+ for (_, coo) in d.oos +%}
    m.add_class::<{{coo.name}}>()?;
    m.add_class::<{{ coo.name }}Enum>()?;
{%- endfor +%}

    Ok(())
}

