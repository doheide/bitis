// Example bitis definition file covering the language.
// Compile e.g. with: bitis compile -l rust -i test.bitis -o test.rs

//| Numbers are encoded as dynamic integer (chunks of 4 bits) of the zero based index
enum Numbers(4) {
  // There is no number here, as this is done automatically
  *One,
  Two,
  Three,
}

enum NumbersAndAHalf(2) {
  OneAndAHalf,
  *TwoAndAHalf,
  ThreeAndAHalf
}

msg Papa {
  oneof oo_lala(2) {
    *uint_8 test;
    float test2;
  }
}

//| Pipi is the message containing the num
msg Pipi {
  //| num means ...
  Numbers num;
}

msg Lala {
  //| comment for lili
  repeated_dyn_4 bool lili;
  //| comment for lala
  repeated_fixed_4 uint_32d4 lala;
  optional uint_12 lolo;
  double qwert;
  // the binary data has variable size
  binary_d4 lele;
  astr_d4 name;
  int_5 signed_val;
  int_16d4 signed_dyn_val;
  fp_10[-2, 3] fixed_point;

  Pipi pipi;
  NumbersAndAHalf nah;

  oneof oo_lala(2) {
    *uint_8 test;
    float test2;
    Papa papa;
  }
}

//| The parent is informational only, attributes are not inherited.
msg Lali : Lala {
  bool lulu;
  fp_32[-100, 180] loli;
}
